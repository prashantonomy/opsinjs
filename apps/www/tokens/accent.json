{
  "$comment": "The accent layer (ADR 0029). Three accent themes, normal, vibes and stryk, each defining the same nine named accents, so a product can change the theme without changing the accent and a reader whose system asks for more contrast keeps the accent they chose. Every value below is an authored literal or a neutral ladder step, chosen against the contrast floors and then measured independently by scripts/check-contrast.mts, which fails the build if any pair falls below its floor. An accent paints action, selection, focus and accent text. It never fills a surface that reports a result, never carries a status or a category, and its hue keeps at least 25 degrees from every status hue, so a control never reads as a level.",
  "cssNaming": {
    "prefix": "--opsin-accent-",
    "themeAttribute": "data-accent-theme",
    "accentAttribute": "data-accent"
  },
  "rules": {
    "$comment": "Checked by scripts/check-contrast.mts. `statusHues` are the four status seeds in color.json; an accent hue closer than `minimumHueDistance` degrees to any of them fails the build. graphite has no hue and is exempt.",
    "statusHues": [
      27,
      45,
      82,
      178
    ],
    "minimumHueDistance": 25
  },
  "roles": {
    "action": {
      "productRole": "--primary",
      "use": "The fill of the one filled action on a surface, Button's primary rung."
    },
    "actionForeground": {
      "productRole": "--primary-foreground",
      "use": "The label on the action fill. Measured against the fill and both of its states at the body floor."
    },
    "actionHover": {
      "productRole": "--state-primary-hover",
      "use": "The action fill under a pointer. It moves away from the label, so the label never loses contrast."
    },
    "actionPress": {
      "productRole": "--state-primary-press",
      "use": "The action fill while pressed or busy. It moves away from the label as well."
    },
    "actionEdge": {
      "productRole": "--primary-edge",
      "use": "The action's boundary. Transparent where the fill alone clears the non-text floor against the page; an ink rim where a bright fill does not."
    },
    "fill": {
      "productRole": "--brand",
      "use": "The selected state of a selection control: a switch that is on, a ticked checkbox, a chosen radio, the range of a slider, a progress fill, the current tab."
    },
    "fillForeground": {
      "productRole": "--brand-foreground",
      "use": "A glyph or a label on the accent fill: a checkbox tick, a chosen scale value. Measured at the body floor."
    },
    "fillEdge": {
      "productRole": "--brand-edge",
      "use": "The boundary of an accent fill, for the same reason as actionEdge."
    },
    "ink": {
      "productRole": "--brand-ink",
      "use": "Accent-coloured text on the page and on a card: a quiet button, an alternative action. Measured at the body floor on both."
    },
    "ring": {
      "productRole": "--ring",
      "use": "The focus ring. Measured at the non-text floor on the page and on a card."
    },
    "glow": {
      "productRole": "--brand-glow",
      "use": "Light thrown by the action, as a shadow colour. Decorative, never a boundary, so it is not measured. Only vibes casts one."
    }
  },
