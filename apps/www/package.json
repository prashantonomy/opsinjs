{
  "name": "@opsinjs/www",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate": "node scripts/build-tokens.mts && node scripts/build-registry.mts && node scripts/build-reference.mts",
    "predev": "pnpm run generate",
    "dev": "next dev --port 4000",
    "prebuild": "pnpm run generate",
    "build": "fumadocs-mdx && next build",
    "start": "next start --port 4000",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mdx,json,css}\"",
    "check": "pnpm run check:generated && pnpm run check:ia && pnpm run check:llms",
    "check:generated": "pnpm run generate && git add -N . && git diff --exit-code -- lib/generated registry/__index__.ts app/tokens.generated.css content/docs/reference/generated public/r",
    "check:ia": "node scripts/assert-ia.mts",
    "check:llms": "node scripts/check-llms.mts",
    "check:freshness": "node scripts/check-freshness.mts",
    "contrast": "node scripts/check-contrast.mts",
    "contrast:verify": "node scripts/check-contrast.mts --verify",
    "capture": "node scripts/capture-registry.mts",
    "evals": "node scripts/run-evals.mts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-typescript": "5.3.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.4",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.20.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
