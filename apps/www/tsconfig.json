{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@opsinjs/react": [
        "../../packages/react/src/index.ts"
      ],
      "@opsinjs/react/*": [
        "../../packages/react/src/components/*.tsx"
      ],
      "@opsinjs/tokens": [
        "../../packages/tokens/src/index.ts"
      ],
      "@opsinjs/color": [
        "../../packages/color/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".source"
  ]
}
