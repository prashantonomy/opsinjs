{
  "name": "opsinjs",
  "private": true,
  "version": "0.0.0",
  "description": "opsinjs — a React design system for consumer health apps, and its documentation site.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "generate": "turbo run generate",
    "format": "prettier --write \"**/*.{ts,tsx,mdx,json,css,md,yml}\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
