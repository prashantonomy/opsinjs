# opsinjs monorepo — pnpm settings
#
# strict-peer-dependencies=false: fumadocs-ui is installed as an alias
# (npm:@fumadocs/base-ui) and peers fumadocs-core at an EXACT version.
# pnpm resolves alias peers pessimistically; without this the install
# fails on a peer set that is in fact satisfied.
strict-peer-dependencies=false

# auto-install-peers=true: @base-ui/react and next are peers of several
# fumadocs packages. We pin them ourselves in apps/www; this only covers
# transitive peers we do not name.
auto-install-peers=true

# Keep the store deterministic across the generate/build/check pipeline.
resolution-mode=highest
prefer-workspace-packages=true
link-workspace-packages=true
