{
  "name": "@opsinjs/react",
  "version": "0.1.0",
  "description": "React components for consumer health apps: readings, ranges, clinical status and the controls around them, built on Base UI.",
  "keywords": [
    "opsinjs",
    "design-system",
    "health",
    "healthcare",
    "accessibility",
    "react",
    "components",
    "base-ui",
    "tailwindcss"
  ],
  "homepage": "https://opsinjs.pensievelabs.org/docs/components",
  "bugs": {
    "url": "https://github.com/prashantonomy/opsinjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prashantonomy/opsinjs.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "the opsinjs authors",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./styles/tailwind.css",
    "./base.css": "./styles/base.css",
    "./roles.css": "./styles/roles.css",
    "./theme.css": "./styles/theme.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean.mts dist && tsc -p tsconfig.build.json && tailwindcss -i styles/standalone.css -o dist/styles.css --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css tailwind.css base.css roles.css theme.css"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opsinjs/tokens": "workspace:^",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
