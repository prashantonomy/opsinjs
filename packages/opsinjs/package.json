{
  "name": "opsinjs",
  "version": "0.1.0",
  "description": "opsinjs, a React design system for consumer health apps. One install for @opsinjs/react, @opsinjs/tokens and @opsinjs/color.",
  "keywords": [
    "opsinjs",
    "design-system",
    "health",
    "healthcare",
    "accessibility",
    "react",
    "components",
    "design-tokens"
  ],
  "homepage": "https://opsinjs.pensievelabs.org",
  "bugs": {
    "url": "https://github.com/prashantonomy/opsinjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prashantonomy/opsinjs.git",
    "directory": "packages/opsinjs"
  },
  "license": "MIT",
  "author": "the opsinjs authors",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "default": "./dist/color.js"
    },
    "./styles.css": "./styles.css",
    "./tailwind.css": "./tailwind.css",
    "./base.css": "./base.css",
    "./tokens.css": "./tokens.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "*.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean.mts dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css tailwind.css base.css tokens.css"
  },
  "dependencies": {
    "@opsinjs/color": "workspace:^",
    "@opsinjs/react": "workspace:^",
    "@opsinjs/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/react": "19.3.0",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
