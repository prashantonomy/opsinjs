{
  "name": "@opsinjs/color",
  "version": "0.1.0",
  "description": "The opsinjs colour engine: OKLCH conversion and gamut mapping, WCAG 2 and APCA contrast, ramp derivation and colour-vision-deficiency simulation. No dependencies.",
  "keywords": [
    "opsinjs",
    "design-system",
    "health",
    "healthcare",
    "accessibility",
    "color",
    "oklch",
    "apca",
    "wcag",
    "contrast",
    "color-blindness"
  ],
  "homepage": "https://opsinjs.pensievelabs.org/docs/foundations/colour",
  "bugs": {
    "url": "https://github.com/prashantonomy/opsinjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prashantonomy/opsinjs.git",
    "directory": "packages/color"
  },
  "license": "MIT",
  "author": "the opsinjs authors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean.mts dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.25",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
