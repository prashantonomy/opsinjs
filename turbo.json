{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", ".npmrc"],
  "tasks": {
    "generate": {
      "inputs": [
        "tokens/**",
        "registry/**",
        "scripts/**",
        "lib/**",
        "content/docs/components/**",
        "content/docs/reference/**"
      ],
      "outputs": [
        "lib/generated/**",
        "registry/__index__.ts",
        "registry/generated/**",
        "app/tokens.generated.css",
        "content/docs/reference/generated/**",
        "content/docs/reference/api/**",
        "content/docs/components/**",
        "public/r/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "public/r/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^build"]
    }
  }
}
