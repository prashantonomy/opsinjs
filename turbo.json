{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "tsconfig.base.json",
    ".npmrc"
  ],
  "tasks": {
    "generate": {
      "inputs": [
        "tokens/**",
        "registry/**",
        "scripts/**",
        "lib/**",
        "content/docs/components/**",
        "content/docs/reference/**",
        "$TURBO_ROOT$/packages/react/src/**",
        "$TURBO_ROOT$/packages/react/styles/**",
        "$TURBO_ROOT$/packages/color/src/**"
      ],
      "outputs": [
        "lib/generated/**",
        "registry/__index__.ts",
        "content/docs/reference/generated/**",
        "content/docs/reference/error-codes.mdx",
        "$TURBO_ROOT$/packages/react/src/index.ts",
        "$TURBO_ROOT$/packages/react/src/opsinjs.ts",
        "$TURBO_ROOT$/packages/tokens/tokens.css",
        "$TURBO_ROOT$/packages/tokens/tokens.json",
        "$TURBO_ROOT$/packages/tokens/src/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "check": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
